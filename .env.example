PORT=3000
NODE_ENV=development
DISPLAY_SECONDS=15
QUEUE_MAX_LENGTH=100

# Persistencia local (una sola instancia de Node.js).
# DATA_DIR debe estar en un disco persistente real en el hosting.
# Un disco efímero borra el estado y los respaldos al reiniciar.
DATA_DIR=./data
STORAGE_FILE_NAME=event-state.json
STORAGE_BACKUP_LIMIT=5

# En producción usa una contraseña larga y aleatoria. Los valores de ejemplo se rechazan.
ADMIN_PASSWORD=dev-admin-password

# Secreto para firmar la cookie de sesión. En producción debe tener 32+ caracteres.
SESSION_SECRET=dev-session-secret-change-me-not-for-production
SESSION_TTL_MINUTES=480

# Dirección pública usada por el QR y la validación de origen.
# Debe ser una URL absoluta. En producción es obligatorio HTTPS.
# No uses Host/X-Forwarded-Host sin validar - esta variable debe estar configurada.
PUBLIC_BASE_URL=http://localhost:3000

# Actívalos si hay un proxy inverso con HTTPS delante (por ejemplo Render).
TRUST_PROXY=0
COOKIE_SECURE=0
